{
  "name": "double-happiness-card-room",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Sheng Ji and Guan Dan card room for friends and AI opponents.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c yellow,cyan \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "clean": "node scripts/clean.mjs",
    "prebuild": "node scripts/check-build-dependencies.mjs",
    "build": "npm run clean && tsc -p tsconfig.server.json && vite build",
    "start": "node scripts/start.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.62.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
